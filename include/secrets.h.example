#ifndef SECRETS_H
#define SECRETS_H

/**
 * Copy this file to `include/secrets.h` and fill in your own values.
 * `include/secrets.h` is gitignored and must never be committed.
 *
 * These credentials are only used for the WiFi-based OTA update mode, which is
 * entered by holding the SW1 button during boot. Normal operation uses BLE and
 * does not bring up WiFi.
 */

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Password required to push an OTA update. Do not leave this empty - without it
// anyone on the network can reflash the board.
#define OTA_PASSWORD "choose-a-strong-password"

#endif // SECRETS_H
